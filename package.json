{
  "name": "group-benefits-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Cross-browser Playwright tests for a Group Benefits Portal",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "typecheck": "tsc --noEmit",
    "mock:portal": "tsx mock-portal/server.ts",
    "report:html": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.19.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
